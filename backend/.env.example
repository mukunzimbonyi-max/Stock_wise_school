# Server
PORT=5000

# Database (Neon Postgres)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT — generate a long random string for production
JWT_SECRET=change_this_to_a_long_random_secret

# Frontend URL (for CORS) — your deployment URL
FRONTEND_URL=https://stock-wise-school.vercel.app
